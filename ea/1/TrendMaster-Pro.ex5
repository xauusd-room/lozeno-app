//+------------------------------------------------------------------+
//|                                        Compressed_Trend_EA.mq5   |
//+------------------------------------------------------------------+
#include <Trade\Trade.mqh>
CTrade trade;
input double InpRisk=1.0; input int FastEMA=20; input int SlowEMA=50; input int ATR_P=14; input ulong Magic=20261017;
int h_fast, h_slow, h_atr; datetime lastBar;

int OnInit() {
   trade.SetExpertMagicNumber(Magic); trade.SetDeviationInPoints(30); trade.SetTypeFillingBySymbol(_Symbol);
   h_fast = iMA(_Symbol, PERIOD_H4, FastEMA, 0, MODE_EMA, PRICE_CLOSE);
   h_slow = iMA(_Symbol, PERIOD_H4, SlowEMA, 0, MODE_EMA, PRICE_CLOSE);
   h_atr  = iATR(_Symbol, _Period, ATR_P);
   return((h_fast==INVALID_HANDLE||h_slow==INVALID_HANDLE||h_atr==INVALID_HANDLE)?INIT_FAILED:INIT_SUCCEEDED);
}

void OnDeinit(const int reason) { IndicatorRelease(h_fast); IndicatorRelease(h_slow); IndicatorRelease(h_atr); }

void OnTick() {
   ManagePositions();
   datetime curBar = iTime(_Symbol, _Period, 0); if(curBar == lastBar || HasPos()) return;
   double f[], s[], a[]; if(CopyBuffer(h_fast,0,1,1,f)<=0||CopyBuffer(h_slow,0,1,1,s)<=0||CopyBuffer(h_atr,0,1,1,a)<=0) return;
   double ask=SymbolInfoDouble(_Symbol,SYMBOL_ASK), bid=SymbolInfoDouble(_Symbol,SYMBOL_BID), slD=a[0]*2.0, tpD=a[0]*4.0, lots=CalcLots(slD);
   if(f[0]>s[0] && trade.Buy(lots,_Symbol,ask,ask-slD,ask+tpD,"B")) lastBar=curBar;
   if(f[0]<s[0] && trade.Sell(lots,_Symbol,bid,bid+slD,bid-tpD,"S")) lastBar=curBar;
}

double CalcLots(double sl) {
   double v=SymbolInfoDouble(_Symbol,SYMBOL_TRADE_TICK_VALUE), s=SymbolInfoDouble(_Symbol,SYMBOL_TRADE_TICK_SIZE), step=SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_STEP);
   if(sl<=0||v<=0||s<=0) return 0.01;
   double l = MathFloor((AccountInfoDouble(ACCOUNT_BALANCE)*(InpRisk/100.0)/((sl/s)*v))/step)*step;
   return(MathMax(SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MIN), MathMin(SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MAX), l)));
}

bool HasPos() {
   for(int i=PositionsTotal()-1; i>=0; i--) if(PositionGetSymbol(i)==_Symbol && PositionGetInteger(POSITION_MAGIC)==Magic) return true;
   return false;
}

void ManagePositions() {
   double a[]; if(CopyBuffer(h_atr,0,0,1,a)<=0) return;
   double p=SymbolInfoDouble(_Symbol,SYMBOL_POINT), ask=SymbolInfoDouble(_Symbol,SYMBOL_ASK), bid=SymbolInfoDouble(_Symbol,SYMBOL_BID);
   for(int i=PositionsTotal()-1; i>=0; i--) {
      if(PositionGetSymbol(i)!=_Symbol || PositionGetInteger(POSITION_MAGIC)!=Magic) continue;
      ulong tk=PositionGetInteger(POSITION_TICKET); 
      double op=PositionGetDouble(POSITION_PRICE_OPEN); 
      double sl=PositionGetDouble(POSITION_SL); 
      double tp=PositionGetDouble(POSITION_TP);
      if(PositionGetInteger(POSITION_TYPE)==POSITION_TYPE_BUY) {
         if(sl<op && (bid-op)>(a[0]*1.5)) trade.PositionModify(tk, op+(10*p), tp);
         else if((bid-op)>(a[0]*2.0) && (bid-(a[0]*2.0))>sl+(a[0]*0.5)) trade.PositionModify(tk, NormalizeDouble(bid-(a[0]*2.0),_Digits), tp);
      } else {
         if((sl>op||sl==0) && (op-ask)>(a[0]*1.5)) trade.PositionModify(tk, op-(10*p), tp);
         else if((op-ask)>(a[0]*2.0) && (sl==0||(ask+(a[0]*2.0))<sl-(a[0]*0.5))) trade.PositionModify(tk, NormalizeDouble(ask+(a[0]*2.0),_Digits), tp);
      }
   }
}
